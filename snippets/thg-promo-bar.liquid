{%- comment -%}
  The Hunter's Gathering: limited-time promo banner at the very top of every page.
  Shows while the promo is running; tapping it applies the code and goes to registration.
{%- endcomment -%}
{%- capture promo_on -%}{%- render 'thg-promo-active' -%}{%- endcapture -%}
{%- if settings.thg_promo_bar and promo_on contains 'yes' and settings.thg_promo_bar_text != blank -%}
  {%- liquid
    assign p_code = settings.thg_promo_code | strip
    assign p_dest = routes.root_url
    if settings.thg_event_product != blank
      assign p_dest = settings.thg_event_product.url
    endif
  -%}
  <a
    class="thg-promo-bar"
    href="{{ routes.root_url }}discount/{{ p_code | url_encode }}?redirect={{ p_dest | url_encode }}"
    style="--promo-bg: {{ settings.thg_promo_bar_bg }}; --promo-text: {{ settings.thg_promo_bar_color }};"
  >
    <span>{{ settings.thg_promo_bar_text | escape }}</span>
    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
  </a>
  <style>
    .thg-promo-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 16px;
      background: var(--promo-bg);
      color: var(--promo-text);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.14em;
      line-height: 1.4;
      text-align: center;
      text-transform: uppercase;
      text-decoration: none;
    }
    .thg-promo-bar:hover span,
    .thg-promo-bar:focus-visible span { text-decoration: underline; text-underline-offset: 3px; }
    .thg-promo-bar svg { flex: none; }
    @media screen and (max-width: 749px) {
      .thg-promo-bar { font-size: 11.5px; letter-spacing: 0.1em; padding: 9px 12px; }
    }
  </style>
{%- endif -%}
