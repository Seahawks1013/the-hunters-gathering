{%- comment -%}
  The Hunter's Gathering: payment choice (deposit vs. pay in full)
  Renders the product's selling plans (created by the Depo app) as radio
  options inside the product form. The chosen option is sent to the cart as
  "selling_plan", Shopify's standard field, so Depo still runs the plan and
  collects the balance.
  Usage (inside {% form 'product' %}): {% render 'thg-selling-plans', product: product %}
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign allocations = variant.selling_plan_allocations
-%}
{%- if product.selling_plan_groups.size > 0 and allocations.size > 0 -%}
  <fieldset class="thg-plans">
    <legend class="thg-plans__legend">How would you like to pay?</legend>

    {%- for allocation in allocations -%}
      {%- liquid
        assign plan = allocation.selling_plan
        assign due_today = allocation.checkout_charge_amount | default: allocation.price
        assign due_later = allocation.remaining_balance_charge_amount
      -%}
      <label class="thg-plans__option">
        <input
          type="radio"
          name="selling_plan"
          value="{{ plan.id }}"
          {% if forloop.first %}checked{% endif %}
        >
        <span class="thg-plans__body">
          <span class="thg-plans__title">{{ plan.name | escape }}</span>
          <span class="thg-plans__detail">
            <strong>{{ due_today | money_without_trailing_zeros }} today</strong>
            {%- if due_later > 0 %} · {{ due_later | money_without_trailing_zeros }} due later{% endif -%}
          </span>
        </span>
        {%- if forloop.first -%}<span class="thg-plans__badge">Most popular</span>{%- endif -%}
      </label>
    {%- endfor -%}

    {%- unless product.requires_selling_plan -%}
      <label class="thg-plans__option">
        <input type="radio" name="selling_plan" value="">
        <span class="thg-plans__body">
          <span class="thg-plans__title">Pay in full</span>
          <span class="thg-plans__detail"><strong>{{ variant.price | money_without_trailing_zeros }} today</strong> · nothing owed later</span>
        </span>
      </label>
    {%- endunless -%}
  </fieldset>

  <style>
    .thg-plans { display: grid; gap: 10px; margin: 0 0 18px; padding: 0; border: 0; min-width: 0; }
    .thg-plans__legend { margin-bottom: 10px; padding: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
    .thg-plans__option { position: relative; display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px; border: 1.5px solid rgb(0 0 0 / 0.15); border-radius: 8px; background: #fff; cursor: pointer; transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease; }
    .thg-plans__option:hover { border-color: rgb(11 74 42 / 0.5); }
    .thg-plans__option:has(input:checked) { border-color: #0b4a2a; background: rgb(11 74 42 / 0.04); box-shadow: 0 0 0 1px #0b4a2a; }
    .thg-plans__option input { flex: none; width: 18px; height: 18px; margin: 2px 0 0; accent-color: #0b4a2a; }
    .thg-plans__option input:focus-visible { outline: 2px solid #daa520; outline-offset: 2px; }
    .thg-plans__body { display: grid; gap: 3px; }
    .thg-plans__title { font-weight: 700; line-height: 1.3; }
    .thg-plans__detail { font-size: 14px; line-height: 1.45; opacity: 0.8; }
    .thg-plans__badge { margin-left: auto; flex: none; padding: 3px 8px; border-radius: 99px; background: #daa520; color: #111; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
  </style>
{%- endif -%}
