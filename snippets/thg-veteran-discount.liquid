{%- comment -%}
  The Hunter's Gathering: honor-system veteran discount
  One tap applies the code from Theme settings → Event registration →
  Veteran discount, using Shopify's /discount/CODE link, without leaving
  the page. The discount then shows up automatically at checkout.
  Usage: {% render 'thg-veteran-discount' %}   tone: 'light' for dark backgrounds
{%- endcomment -%}
{%- if settings.thg_vet_code != blank -%}
  {%- assign code = settings.thg_vet_code | strip -%}
  <thg-vet-discount class="thg-vet thg-vet--{{ tone | default: 'dark' }}" data-code="{{ code | escape }}">
    <span class="thg-vet__flag" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.5 8 11 4.6-1.5 8-6 8-11V5l-8-3zm0 4.2 1.4 2.9 3.2.5-2.3 2.2.5 3.2-2.8-1.5-2.8 1.5.5-3.2-2.3-2.2 3.2-.5L12 6.2z"/></svg>
    </span>
    <span class="thg-vet__text">{{ settings.thg_vet_label | escape }}</span>
    <a
      class="thg-vet__btn"
      href="{{ routes.root_url }}discount/{{ code | url_encode }}?redirect={{ request.path | url_encode }}"
      data-label="{{ settings.thg_vet_button | escape }}"
    >{{ settings.thg_vet_button | escape }}</a>
    <span class="thg-vet__done" role="status" hidden>
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5l3.5 3.5 7.5-8"/></svg>
      {{ settings.thg_vet_applied | escape }}
    </span>
  </thg-vet-discount>

  <style>
    .thg-vet {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 12px;
      margin: 0 0 16px;
      padding: 12px 14px;
      border: 1.5px dashed color-mix(in srgb, var(--thg-green) 45%, transparent);
      border-radius: 8px;
      background: color-mix(in srgb, var(--thg-green) 4%, transparent);
      color: #111;
      font-size: 15px;
      line-height: 1.4;
    }

    .thg-vet--light {
      border-color: rgb(255 255 255 / 0.35);
      background: rgb(255 255 255 / 0.06);
      color: #fff;
    }

    .thg-vet__flag {
      display: grid;
      place-items: center;
      flex: none;
      color: var(--thg-green);
    }

    .thg-vet--light .thg-vet__flag { color: #daa520; }

    .thg-vet__text { font-weight: 600; flex: 1 1 auto; }

    .thg-vet__btn {
      flex: none;
      padding: 8px 14px;
      border-radius: 99px;
      background: var(--thg-green);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background-color 0.2s ease;
    }

    .thg-vet__btn:hover,
    .thg-vet__btn:focus-visible { background: #111; color: #daa520; }

    .thg-vet--light .thg-vet__btn { background: #daa520; color: #111; }
    .thg-vet--light .thg-vet__btn:hover { background: #fff; }

    .thg-vet__btn[aria-busy='true'] { opacity: 0.6; pointer-events: none; }

    .thg-vet__done {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-basis: 100%;
      font-size: 14px;
      font-weight: 600;
      color: var(--thg-green);
    }

    .thg-vet--light .thg-vet__done { color: #f3d57e; }
    .thg-vet__done[hidden] { display: none; }
    .thg-vet.is-applied { border-style: solid; }
  </style>

  <script>
    if (!customElements.get('thg-vet-discount')) {
      customElements.define('thg-vet-discount', class extends HTMLElement {
        connectedCallback() {
          // Wait until the element's children are parsed
          if (!this.querySelector('.thg-vet__btn')) {
            requestAnimationFrame(() => this.connectedCallback());
            return;
          }
          if (this.dataset.ready) return;
          this.dataset.ready = '1';
          const btn = this.querySelector('.thg-vet__btn');
          const done = this.querySelector('.thg-vet__done');
          const code = (this.dataset.code || '').toLowerCase();
          const applied = () => {
            this.classList.add('is-applied');
            btn.hidden = true;
            done.hidden = false;
          };
          try {
            if (code && document.cookie.toLowerCase().includes('discount_code=' + encodeURIComponent(code))) applied();
          } catch (e) {}
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            btn.setAttribute('aria-busy', 'true');
            try {
              // Visiting /discount/CODE stores the code for checkout
              await fetch(btn.getAttribute('href').split('?')[0], { credentials: 'same-origin', redirect: 'follow' });
              document.querySelectorAll('thg-vet-discount').forEach((el) => el.markApplied && el.markApplied());
              applied();
            } catch (err) {
              window.location.href = btn.href; // fall back to a normal visit
            } finally {
              btn.removeAttribute('aria-busy');
            }
          });
          this.markApplied = applied;
        }
      });
    }
  </script>
{%- endif -%}
