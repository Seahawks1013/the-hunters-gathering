{%- comment -%}
  The Hunter's Gathering: Social links, podcasts and partners
  Block types:
  - Social link (Instagram, Facebook, YouTube, Podcast, TikTok, Website)
  - Podcast (cover, host, description, link)
  - Partner logo
{%- endcomment -%}

{%- liquid
  assign socials = section.blocks | where: 'type', 'social'
  assign podcasts = section.blocks | where: 'type', 'podcast'
  assign partners = section.blocks | where: 'type', 'partner'
-%}

<div
  class="thg-sec thg-soc"
  style="
    --thg-bg: {{ section.settings.background_color }};
    --thg-text: {{ section.settings.text_color }};
    --thg-pad-top: {{ section.settings.padding_top }}px;
    --thg-pad-bottom: {{ section.settings.padding_bottom }}px;
    --thg-tag-bg: var(--thg-gold);
    --thg-tag-text: var(--thg-ink);
    {%- render 'thg-section-colors', s: section.settings -%}
  "
>
  <div class="thg-wrap">
    <div class="thg-head">
      {%- if section.settings.tag != blank -%}<p class="thg-tag">{{ section.settings.tag | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="thg-h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="thg-sub">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- if socials.size > 0 -%}
      <ul class="thg-soc__links" role="list">
        {%- for block in socials -%}
          <li {{ block.shopify_attributes }}>
            <a class="thg-soc__link" href="{{ block.settings.url | default: '#' }}" target="_blank" rel="noopener">
              <span class="thg-soc__icon">
                {%- case block.settings.platform -%}
                  {%- when 'tiktok' -%}
                    <svg class="thg-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.6 2h-3.4v13.4a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9.1a6.4 6.4 0 1 0 5.4 6.3V8.7a7.9 7.9 0 0 0 4.6 1.5V6.8a4.6 4.6 0 0 1-4.6-4.8z"/></svg>
                  {%- else -%}
                    {%- render 'thg-social-icon', icon: block.settings.platform -%}
                {%- endcase -%}
              </span>
              <span class="thg-soc__text">
                <span class="thg-soc__platform">{{ block.settings.label | default: block.settings.platform | capitalize | escape }}</span>
                {%- if block.settings.handle != blank -%}
                  <span class="thg-soc__handle">{{ block.settings.handle | escape }}</span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if podcasts.size > 0 -%}
      <div class="thg-soc__pods">
        {%- if section.settings.podcast_heading != blank -%}
          <h3 class="thg-soc__subhead">{{ section.settings.podcast_heading | escape }}</h3>
        {%- endif -%}
        <ul class="thg-soc__pod-grid" role="list">
          {%- for block in podcasts -%}
            <li class="thg-soc__pod" {{ block.shopify_attributes }}>
              <a class="thg-soc__pod-cover" href="{{ block.settings.url | default: '#' }}" target="_blank" rel="noopener" aria-label="Listen: {{ block.settings.title | escape }}">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 700 | image_tag: widths: '300, 500, 700', sizes: '(min-width: 990px) 360px, 85vw', loading: 'lazy', alt: '' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'thg-soc__pod-placeholder' }}
                {%- endif -%}
                <span class="thg-soc__pod-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M8 5.5v13l11-6.5z"/></svg>
                </span>
              </a>
              {%- if block.settings.host != blank -%}<p class="thg-soc__pod-host">{{ block.settings.host | escape }}</p>{%- endif -%}
              <h4 class="thg-soc__pod-title">{{ block.settings.title | escape }}</h4>
              {%- if block.settings.description != blank -%}<div class="thg-soc__pod-desc">{{ block.settings.description }}</div>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if partners.size > 0 -%}
      <div class="thg-soc__partners">
        {%- if section.settings.partners_heading != blank -%}
          <h3 class="thg-soc__subhead">{{ section.settings.partners_heading | escape }}</h3>
        {%- endif -%}
        <ul class="thg-soc__partner-row" role="list">
          {%- for block in partners -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}" target="_blank" rel="noopener">{%- endif -%}
              {%- if block.settings.logo != blank -%}
                {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name, class: 'thg-soc__partner-logo' }}
              {%- else -%}
                <span class="thg-soc__partner-name">{{ block.settings.name | escape }}</span>
              {%- endif -%}
              {%- if block.settings.url != blank -%}</a>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .thg-soc__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    max-width: 960px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .thg-soc__links { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  }

  .thg-soc__link {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    padding: 16px 18px;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .thg-soc__link:hover,
  .thg-soc__link:focus-visible {
    background: rgb(255 255 255 / 0.06);
    border-color: var(--thg-gold);
    transform: translateY(-2px);
  }

  .thg-soc__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--thg-gold);
    color: var(--thg-ink);
  }

  .thg-soc__icon .thg-icon { width: 20px; height: 20px; }

  .thg-soc__text { display: grid; min-width: 0; }

  .thg-soc__platform {
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 14px;
  }

  .thg-soc__handle {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
    opacity: 0.7;
  }

  .thg-soc__subhead {
    margin: 0 0 28px;
    text-align: center;
    font-family: var(--font-heading--family);
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
  }

  .thg-soc__pods { margin-top: clamp(56px, 7vw, 88px); }

  .thg-soc__pod-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thg-soc__pod-cover {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 6px;
    background: #222;
  }

  .thg-soc__pod-cover img,
  .thg-soc__pod-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .thg-soc__pod-placeholder { fill: rgb(255 255 255 / 0.15); }

  .thg-soc__pod-cover:hover img { transform: scale(1.04); }

  .thg-soc__pod-play {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--thg-gold);
    color: var(--thg-ink);
    box-shadow: 0 10px 20px -8px rgb(0 0 0 / 0.6);
  }

  .thg-soc__pod-play svg { margin-left: 3px; }

  .thg-soc__pod-host {
    margin: 18px 0 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--thg-gold);
  }

  .thg-soc__pod-title {
    margin: 0 0 8px;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
    color: inherit;
  }

  .thg-soc__pod-desc {
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.75;
  }

  .thg-soc__pod-desc p { margin: 0; }

  .thg-soc__partners {
    margin-top: clamp(56px, 7vw, 88px);
    padding-top: clamp(40px, 5vw, 56px);
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .thg-soc__partner-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 22px 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thg-soc__partner-logo {
    display: block;
    width: auto;
    max-width: 150px;
    max-height: 64px;
    object-fit: contain;
    filter: grayscale(1) brightness(1.6);
    opacity: 0.8;
    transition: filter 0.3s ease, opacity 0.3s ease;
  }

  .thg-soc__partner-row a:hover .thg-soc__partner-logo {
    filter: none;
    opacity: 1;
  }

  .thg-soc__partner-name {
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .thg-soc__pod-grid { grid-template-columns: 1fr; gap: 36px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social & podcasts",
  "tag": "section",
  "class": "thg-soc-section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Label",
      "default": "Stay in the hunt"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow The Hunter's Gathering"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "podcast_heading",
      "label": "Podcasts heading",
      "default": "Voices of The Hunter's Gathering"
    },
    {
      "type": "text",
      "id": "partners_heading",
      "label": "Partners heading",
      "default": "Our Partners"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "More colors",
      "info": "Leave any of these empty to use the brand colors from Theme settings → Brand colors."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (checkmarks, links, lines)"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "label_bg",
      "label": "Label background"
    },
    {
      "type": "color",
      "id": "label_text",
      "label": "Label text"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "podcast",
              "label": "Podcast"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "website",
              "label": "Website"
            }
          ],
          "default": "instagram"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (optional)"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle (optional)",
          "info": "e.g. @thehuntersgathering"
        }
      ]
    },
    {
      "type": "podcast",
      "name": "Podcast",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover"
        },
        {
          "type": "text",
          "id": "host",
          "label": "Host",
          "default": "Host name"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Podcast title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Listen link"
        }
      ]
    },
    {
      "type": "partner",
      "name": "Partner logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Partner"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social & podcasts",
      "blocks": [
        {
          "type": "social",
          "settings": {
            "platform": "instagram"
          }
        },
        {
          "type": "social",
          "settings": {
            "platform": "facebook"
          }
        },
        {
          "type": "social",
          "settings": {
            "platform": "youtube"
          }
        },
        {
          "type": "social",
          "settings": {
            "platform": "podcast"
          }
        }
      ]
    }
  ]
}
{% endschema %}
