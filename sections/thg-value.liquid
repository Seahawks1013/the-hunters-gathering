{%- comment -%}
  The Hunter's Gathering: What's included (itemized value)
  A receipt-style breakdown backing up the "Over $5,000 value" claim,
  plus a card for the field kit contents ("Over $400 kit value").
{%- endcomment -%}

<div
  class="thg-sec thg-val"
  style="
    --thg-bg: {{ section.settings.background_color }};
    --thg-text: {{ section.settings.text_color }};
    --thg-pad-top: {{ section.settings.padding_top }}px;
    --thg-pad-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'thg-section-colors', s: section.settings -%}
  "
>
  <div class="thg-wrap">
    <div class="thg-head">
      {%- if section.settings.tag != blank -%}<p class="thg-tag">{{ section.settings.tag | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="thg-h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="thg-sub">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="thg-val__layout">
      <div class="thg-val__receipt">
        <p class="thg-val__receipt-title">{{ section.settings.receipt_title | escape }}</p>
        <ul class="thg-val__lines" role="list">
          {%- for block in section.blocks -%}
            <li class="thg-val__line" {{ block.shopify_attributes }}>
              <div class="thg-val__item">
                <span class="thg-val__item-title">{{ block.settings.title | escape }}</span>
                {%- if block.settings.detail != blank -%}
                  <span class="thg-val__item-detail">{{ block.settings.detail | escape }}</span>
                {%- endif -%}
              </div>
              <span class="thg-val__leader" aria-hidden="true"></span>
              <span class="thg-val__amount">{{ block.settings.value | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>

        <div class="thg-val__totals">
          <div class="thg-val__total">
            <span>{{ section.settings.total_label | escape }}</span>
            <span class="thg-val__total-value">{{ section.settings.total_value | escape }}</span>
          </div>
          <div class="thg-val__yours">
            <span>{{ section.settings.price_label | escape }}</span>
            <span class="thg-val__yours-value">{{ section.settings.price_value | escape }}</span>
          </div>
        </div>
        {%- if section.settings.footnote != blank -%}
          <p class="thg-val__footnote">{{ section.settings.footnote | escape }}</p>
        {%- endif -%}
      </div>

      <aside class="thg-val__kit">
        <div class="thg-val__kit-media">
          {%- if section.settings.kit_image != blank -%}
            {{ section.settings.kit_image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 420px, 100vw', loading: 'lazy', alt: section.settings.kit_title }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'thg-val__kit-placeholder' }}
          {%- endif -%}
          {%- if section.settings.kit_value != blank -%}
            <span class="thg-val__kit-badge">{{ section.settings.kit_value | escape }}</span>
          {%- endif -%}
        </div>
        <div class="thg-val__kit-body">
          <h3 class="thg-val__kit-title">{{ section.settings.kit_title | escape }}</h3>
          {%- if section.settings.kit_items != blank -%}
            <div class="thg-rich-checks thg-val__kit-items">{{ section.settings.kit_items }}</div>
          {%- endif -%}
        </div>
      </aside>
    </div>
  </div>
</div>

{% stylesheet %}
  .thg-val__layout {
    display: grid;
    gap: 28px;
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .thg-val__layout {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 40px;
    }
  }

  /* Receipt */
  .thg-val__receipt {
    position: relative;
    padding: clamp(24px, 4vw, 44px);
    background: var(--thg-card-bg, #fff);
    color: var(--thg-card-text, var(--thg-ink));
    border-radius: 4px;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.35);
  }

  .thg-val__receipt-title {
    margin: 0 0 18px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--thg-ink);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .thg-val__lines {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thg-val__line {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: 10px;
    padding: 14px 0;
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }

  .thg-val__item {
    display: grid;
    gap: 2px;
    max-width: 30ch;
  }

  .thg-val__item-title {
    font-size: 17px;
    font-weight: 700;
  }

  .thg-val__item-detail {
    font-size: 14px;
    line-height: 1.45;
    opacity: 0.7;
  }

  .thg-val__leader {
    align-self: end;
    margin-bottom: 6px;
    border-bottom: 2px dotted rgb(0 0 0 / 0.25);
  }

  .thg-val__amount {
    font-family: var(--font-heading--family);
    font-size: 18px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .thg-val__totals {
    display: grid;
    gap: 10px;
    margin-top: 22px;
  }

  .thg-val__total,
  .thg-val__yours {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .thg-val__total { font-size: 15px; opacity: 0.75; }

  .thg-val__total-value {
    font-size: 22px;
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--thg-orange);
  }

  .thg-val__yours {
    padding: 14px 18px;
    background: var(--thg-green);
    color: #fff;
    border-radius: 3px;
  }

  .thg-val__yours-value {
    font-family: var(--font-heading--family);
    font-size: 30px;
    color: var(--thg-gold-soft);
  }

  .thg-val__footnote {
    margin: 14px 0 0;
    font-size: 13px;
    opacity: 0.6;
  }

  /* Kit card */
  .thg-val__kit {
    overflow: hidden;
    background: var(--thg-ink);
    color: #fff;
    border-radius: 4px;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.5);
    --thg-check-bg: var(--thg-gold);
  }

  .thg-val__kit-media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #2a2a2a;
  }

  .thg-val__kit-media img,
  .thg-val__kit-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .thg-val__kit-placeholder { fill: rgb(255 255 255 / 0.15); }

  .thg-val__kit-badge {
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 8px 14px;
    background: var(--thg-gold);
    color: var(--thg-ink);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .thg-val__kit-body { padding: 24px 26px 30px; }

  .thg-val__kit-title {
    margin: 0 0 16px;
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    color: inherit;
  }

  .thg-val__kit-items { font-size: 16px; }
  .thg-val__kit-items p { margin: 0 0 0.6em; }

  @media screen and (max-width: 749px) {
    .thg-val__line {
      grid-template-columns: 1fr auto;
    }

    .thg-val__leader { display: none; }
  }
{% endstylesheet %}

{% schema %}
