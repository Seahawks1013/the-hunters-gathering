{%- comment -%}
  The Hunter's Gathering: Testimonials
  Short attendee quotes (with optional photo and video link), placed right
  before the pricing section so social proof sits next to the Reserve button.
{%- endcomment -%}

<div
  class="thg-sec thg-tst"
  style="
    --thg-bg: {{ section.settings.background_color }};
    --thg-text: {{ section.settings.text_color }};
    --thg-pad-top: {{ section.settings.padding_top }}px;
    --thg-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="thg-wrap">
    <div class="thg-head">
      {%- if section.settings.tag != blank -%}<p class="thg-tag">{{ section.settings.tag | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="thg-h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="thg-sub">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <ul class="thg-tst__list" role="list">
      {%- for block in section.blocks -%}
        <li class="thg-tst__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="thg-tst__media">
              {{ block.settings.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 380px, 85vw', loading: 'lazy', alt: block.settings.name }}
            </div>
          {%- endif -%}
          <figure class="thg-tst__body">
            {%- if section.settings.show_stars -%}
              <div class="thg-tst__stars" aria-label="5 out of 5 stars">★★★★★</div>
            {%- endif -%}
            <blockquote class="thg-tst__quote">{{ block.settings.quote }}</blockquote>
            <figcaption class="thg-tst__who">
              <span class="thg-tst__name">{{ block.settings.name | escape }}</span>
              {%- if block.settings.detail != blank -%}
                <span class="thg-tst__detail">{{ block.settings.detail | escape }}</span>
              {%- endif -%}
            </figcaption>
            {%- if block.settings.video_url != blank -%}
              <a class="thg-tst__video" href="{{ block.settings.video_url }}" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13l11-6.5z"/></svg>
                Watch their story
              </a>
            {%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_reserve -%}
      <div class="thg-tst__cta">
        {%- render 'thg-reserve-button', link: section.settings.reserve_link -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .thg-tst__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thg-tst__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #fff;
    color: var(--thg-ink);
    border-radius: 6px;
    box-shadow: 0 26px 50px -30px rgb(0 0 0 / 0.55);
  }

  .thg-tst__media {
    aspect-ratio: 4 / 3;
    background: #eee;
  }

  .thg-tst__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .thg-tst__body {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    margin: 0;
    padding: 28px 26px 26px;
  }

  .thg-tst__body::before {
    content: '\201C';
    position: absolute;
    top: 6px;
    right: 20px;
    font-family: Georgia, serif;
    font-size: 96px;
    line-height: 1;
    color: var(--thg-gold);
    opacity: 0.35;
  }

  .thg-tst__stars {
    margin-bottom: 12px;
    color: var(--thg-orange);
    font-size: 16px;
    letter-spacing: 0.15em;
  }

  .thg-tst__quote {
    flex: 1;
    margin: 0 0 22px;
    font-size: 17px;
    line-height: 1.6;
  }

  .thg-tst__quote p { margin: 0 0 0.6em; }
  .thg-tst__quote > :last-child { margin-bottom: 0; }

  .thg-tst__who {
    display: grid;
    gap: 2px;
    padding-top: 16px;
    border-top: 2px solid var(--thg-gold);
  }

  .thg-tst__name {
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .thg-tst__detail {
    font-size: 14px;
    opacity: 0.65;
  }

  .thg-tst__video {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    color: var(--thg-green);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .thg-tst__cta {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }

  @media screen and (max-width: 989px) {
    .thg-tst { padding-inline: 0; }
    .thg-tst .thg-head,
    .thg-tst__cta { padding-inline: 16px; }

    .thg-tst__list {
      display: flex;
      gap: 14px;
      padding: 0 16px 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 16px;
      scrollbar-width: none;
    }

    .thg-tst__list::-webkit-scrollbar { display: none; }

    .thg-tst__card {
      flex: 0 0 min(84%, 380px);
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "thg-tst-section",
  "max_blocks": 12,
  "settings": [
    { "type": "url", "id": "reserve_link", "label": "Reserve button link (optional)", "info": "Leave empty to use the registration product from Theme settings → Event registration." },
    { "type": "text", "id": "tag", "label": "Label", "default": "From past attendees" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Success Is No Accident" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_stars", "label": "Show 5 stars", "default": true },
    { "type": "checkbox", "id": "show_reserve", "label": "Show Reserve button", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#DAA520" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>Add a short quote from a past attendee here.</p>" },
        { "type": "text", "id": "name", "label": "Name", "default": "Attendee name" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "2026 attendee" },
        { "type": "image_picker", "id": "image", "label": "Photo (optional)" },
        { "type": "url", "id": "video_url", "label": "Video link (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "Testimonials", "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }] }
  ]
}
{% endschema %}
