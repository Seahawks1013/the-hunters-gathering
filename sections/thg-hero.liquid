{%- comment -%}
  The Hunter's Gathering: Home hero
  Full-width image (placeholder until uploaded) with an event info bar:
  dates, location, seats, price, Reserve button and seat counter.
  On phones the image is kept short so dates, price and the button sit
  above the fold, and an optional sticky Reserve bar follows the scroll.
{%- endcomment -%}

<div
  class="thg-hero thg-hero--{{ section.settings.desktop_height }}"
  style="
    --thg-bar-bg: {{ section.settings.bar_background }};
    --thg-bar-text: {{ section.settings.bar_text }};
    --thg-mobile-media-h: {{ section.settings.mobile_image_height }}svh;
  "
>
  <div class="thg-hero__media">
    {%- liquid
      assign desk = section.settings.image
      assign mob = section.settings.mobile_image | default: desk
      assign alt = desk.alt | default: "The Hunter's Gathering, April 8 to 11, 2027 in Yelm, Washington"
    -%}
    {%- capture focal -%}object-position: {{ desk.presentation.focal_point }};{%- endcapture -%}
    {%- if desk != blank -%}
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mob | image_url: width: 750 }} 750w, {{ mob | image_url: width: 1100 }} 1100w, {{ mob | image_url: width: 1500 }} 1500w"
            sizes="100vw"
          >
        {%- endif -%}
        {{
          desk
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2600, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: alt,
            class: 'thg-hero__img',
            style: focal
        }}
      </picture>
    {%- else -%}
      <div class="thg-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'thg-hero__placeholder-svg' }}
        <span>Hero image goes here</span>
      </div>
    {%- endif -%}
  </div>

  <div class="thg-hero__bar">
    <div class="thg-hero__bar-inner">
      <div class="thg-hero__info">
        {%- if section.settings.date_text != blank -%}
          <p class="thg-hero__date">{{ section.settings.date_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.headline != blank -%}
          <h1 class="thg-hero__headline">{{ section.settings.headline | escape }}</h1>
        {%- endif -%}
        <ul class="thg-hero__facts" role="list">
          {%- if section.settings.location != blank -%}
            <li>
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M10 1.8a6 6 0 0 0-6 6c0 4.5 6 10.4 6 10.4s6-5.9 6-10.4a6 6 0 0 0-6-6zm0 8.2a2.2 2.2 0 1 1 0-4.4 2.2 2.2 0 0 1 0 4.4z"/></svg>
              {{ section.settings.location | escape }}
            </li>
          {%- endif -%}
          {%- if section.settings.capacity != blank -%}
            <li>
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M7 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm7 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM1 16c0-3 2.7-5 6-5s6 2 6 5v1H1v-1zm13.5-4.9c2.6.2 4.5 1.9 4.5 4.4V17h-4.5v-1c0-1.9-.7-3.5-2-4.6.6-.2 1.3-.3 2-.3z"/></svg>
              {{ section.settings.capacity | escape }}
            </li>
          {%- endif -%}
          {%- if section.settings.venue != blank -%}
            <li>
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M10 2 1 9h2.5v9h5v-5h3v5h5V9H19z"/></svg>
              {{ section.settings.venue | escape }}
            </li>
          {%- endif -%}
        </ul>
      </div>

      <div class="thg-hero__cta" id="thg-hero-cta">
        <div class="thg-hero__price">
          {%- if section.settings.price != blank -%}
            <span class="thg-hero__price-amount">{{ section.settings.price | escape }}</span>
          {%- endif -%}
          {%- if section.settings.price_note != blank -%}
            <span class="thg-hero__price-note">{{ section.settings.price_note | escape }}</span>
          {%- endif -%}
        </div>
        {%- render 'thg-reserve-button', variant: 'light', full: true -%}
        {%- render 'thg-seat-counter', show_bar: true, tone: 'light' -%}
        {%- if section.settings.show_guide_link -%}
          <a class="thg-hero__guide" href="{{ settings.thg_guide_link | default: '#event-guide' }}">
            {{ section.settings.guide_link_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.sticky_mobile -%}
    <thg-sticky-reserve class="thg-sticky" hidden>
      <div class="thg-sticky__price">
        <strong>{{ section.settings.price | escape }}</strong>
        <span>{{ section.settings.sticky_note | escape }}</span>
      </div>
      {%- render 'thg-reserve-button' -%}
    </thg-sticky-reserve>
  {%- endif -%}
</div>

{% stylesheet %}
  .thg-hero {
    position: relative;
    background: var(--thg-bar-bg);
  }

  .thg-hero__media {
    position: relative;
    background: #0b0b0b;
  }

  .thg-hero__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .thg-hero--screen .thg-hero__img {
    height: min(78vh, 900px);
    object-fit: cover;
  }

  .thg-hero__placeholder {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 7;
    background: linear-gradient(160deg, #0b4a2a, #06331c 60%, #3b2a0c);
    color: #f3d57e;
    overflow: hidden;
  }

  .thg-hero__placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: rgb(255 255 255 / 0.08);
  }

  .thg-hero__placeholder span {
    position: relative;
    padding: 10px 18px;
    border: 1px dashed currentColor;
    font-family: var(--font-body--family);
    font-size: 14px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Info bar */
  .thg-hero__bar {
    position: relative;
    background: var(--thg-bar-bg);
    color: var(--thg-bar-text);
    border-top: 4px solid var(--thg-gold);
  }

  .thg-hero__bar-inner {
    display: grid;
    gap: 22px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 16px 28px;
  }

  @media screen and (min-width: 990px) {
    .thg-hero__bar-inner {
      grid-template-columns: 1fr minmax(360px, 420px);
      align-items: center;
      gap: 56px;
      padding: 40px 24px 44px;
    }
  }

  .thg-hero__date {
    display: inline-block;
    margin: 0 0 14px;
    padding: 6px 14px 5px;
    background: var(--thg-gold);
    color: var(--thg-ink);
    font-family: var(--font-heading--family);
    font-size: clamp(20px, 2.6vw, 30px);
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .thg-hero__headline {
    margin: 0 0 14px;
    font-family: var(--font-heading--family);
    font-size: clamp(30px, 4.4vw, 54px);
    font-weight: 700;
    line-height: 1.02;
    text-transform: uppercase;
    color: inherit;
  }

  .thg-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body--family);
    font-size: 16px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .thg-hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .thg-hero__facts svg {
    color: var(--thg-gold);
    flex: none;
  }

  .thg-hero__cta {
    display: grid;
    gap: 14px;
  }

  .thg-hero__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .thg-hero__price-amount {
    font-family: var(--font-heading--family);
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
  }

  .thg-hero__price-note {
    font-size: 15px;
    opacity: 0.85;
  }

  .thg-hero__guide {
    justify-self: center;
    color: inherit;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-decoration: underline;
    text-underline-offset: 4px;
    opacity: 0.85;
  }

  .thg-hero__guide:hover { opacity: 1; }

  /* Phones: short image so dates, price and button are above the fold */
  @media screen and (max-width: 749px) {
    .thg-hero__img,
    .thg-hero--screen .thg-hero__img {
      height: auto;
      max-height: var(--thg-mobile-media-h);
      object-fit: cover;
    }

    .thg-hero__placeholder {
      aspect-ratio: auto;
      height: var(--thg-mobile-media-h);
    }

    .thg-hero__bar-inner {
      padding-top: 18px;
      gap: 18px;
    }

    .thg-hero__date { margin-bottom: 10px; }

    .thg-hero__facts {
      gap: 6px 18px;
      font-size: 14px;
    }

    .thg-hero__price-amount { font-size: 32px; }
  }

  /* Sticky Reserve bar (phones only) */
  .thg-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: #fff;
    color: var(--thg-ink);
    box-shadow: 0 -8px 24px rgb(0 0 0 / 0.18);
    transform: translateY(110%);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .thg-sticky.is-visible { transform: none; }

  .thg-sticky[hidden] { display: none; }

  .thg-sticky__price {
    display: grid;
    line-height: 1.15;
  }

  .thg-sticky__price strong {
    font-family: var(--font-heading--family);
    font-size: 20px;
  }

  .thg-sticky__price span {
    font-size: 12px;
    opacity: 0.75;
  }

  .thg-sticky .thg-btn {
    min-height: 46px;
    padding: 10px 14px;
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .thg-sticky .thg-btn__arrow { display: none; }

  @media screen and (min-width: 750px) {
    .thg-sticky { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .thg-sticky { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('thg-sticky-reserve')) {
    customElements.define(
      'thg-sticky-reserve',
      class extends HTMLElement {
        connectedCallback() {
          const target = document.getElementById('thg-hero-cta');
          if (!target || !('IntersectionObserver' in window)) return;
          this.hidden = false;
          // Hide while the hero button is on screen or the pricing section is visible
          const pricing = document.getElementById('reserve');
          const seen = new Map();
          const update = () => {
            const anyVisible = Array.from(seen.values()).some(Boolean);
            const scrolledPast = target.getBoundingClientRect().bottom < 0;
            this.classList.toggle('is-visible', !anyVisible && scrolledPast);
          };
          this.observer = new IntersectionObserver((entries) => {
            entries.forEach((e) => seen.set(e.target, e.isIntersecting));
            update();
          });
          this.observer.observe(target);
          if (pricing) this.observer.observe(pricing);
          window.addEventListener('scroll', update, { passive: true });
        }

        disconnectedCallback() {
          if (this.observer) this.observer.disconnect();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Event hero",
  "tag": "section",
  "class": "thg-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Phone image (optional)",
      "info": "A taller crop for phones. Uses the hero image if empty."
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Image height on desktop",
      "options": [
        { "value": "natural", "label": "Show the full image" },
        { "value": "screen", "label": "Fill most of the screen (crops edges)" }
      ],
      "default": "natural"
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Max image height on phones",
      "min": 25,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 40,
      "info": "Keep this low so the dates, price and button show without scrolling."
    },
    {
      "type": "header",
      "content": "Event details"
    },
    {
      "type": "text",
      "id": "date_text",
      "label": "Dates",
      "default": "April 8–11, 2027"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline (optional)",
      "default": "Success Is No Accident"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "default": "Yelm, WA"
    },
    {
      "type": "text",
      "id": "capacity",
      "label": "Capacity",
      "default": "Limited to 100 hunters"
    },
    {
      "type": "text",
      "id": "venue",
      "label": "Venue",
      "default": "Cabins, meals & field kit included"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$1,795"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price note",
      "default": "Reserve today with a $350 deposit"
    },
    {
      "type": "checkbox",
      "id": "show_guide_link",
      "label": "Show Event Guide link",
      "default": true
    },
    {
      "type": "text",
      "id": "guide_link_text",
      "label": "Event Guide link text",
      "default": "Not ready yet? Get the free 2027 Event Guide"
    },
    {
      "type": "header",
      "content": "Sticky bar on phones"
    },
    {
      "type": "checkbox",
      "id": "sticky_mobile",
      "label": "Show sticky Reserve bar after scrolling",
      "default": true
    },
    {
      "type": "text",
      "id": "sticky_note",
      "label": "Sticky bar note",
      "default": "$350 deposit · payment plan"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bar_background",
      "label": "Info bar background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bar_text",
      "label": "Info bar text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Event hero"
    }
  ]
}
{% endschema %}
